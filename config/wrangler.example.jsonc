{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ria-noel-shop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ria-noel-shop",
      "database_id": "REPLACE_ME"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "ria-noel-shop-files"
    }
  ]
}
